on property:sys.boot_completed=1
# set inactive_apps_id
    chown system system /sys/fs/cgroup/apps/inactive_apps
    #write /sys/fs/cgroup/apps/inactive_apps/memory.flags "1"
    chown system system /sys/fs/cgroup/apps/inactive_apps/memory.flags

service init.oplus.nandswap.sh /product/bin/init.oplus.nandswap.sh "boot_completed"
    class late_start
    user root
    group system
    disabled
    oneshot

on property:sys.boot_completed=1
    restorecon_recursive /data/nandswap
    exec - root system -- /bin/rm -rf /data/nandswap
    mkdir /data/nandswap 0700 root root encryption=Require key=per_boot_ref

    chown root system /dev/memcg/memory.active_app_info_list
    chmod 0440 /dev/memcg/memory.active_app_info_list
    chown root system /dev/memcg/memory.zram_wm_ratio
