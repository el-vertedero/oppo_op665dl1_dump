service init.oplus.nandswap_post-fs-data.sh /product/bin/init.oplus.nandswap.sh "post-fs-data"
    class late_start
    user root
    group system
    disabled
    oneshot

on post-fs-data
    start init.oplus.nandswap_post-fs-data.sh

# Enable app per-application memory controller
on post-fs-data
    write /sys/fs/cgroup/apps/cgroup.subtree_control "+memory"
# for memcg-V2
# for root
    chmod 0775 /sys/fs/cgroup/memory.active_app_info_list
    chmod 0775 /sys/fs/cgroup/memory.aging_anon
    chmod 0775 /sys/fs/cgroup/memory.anon_refault_snapshot_min_interval
    chmod 0775 /sys/fs/cgroup/memory.app_score
    chmod 0775 /sys/fs/cgroup/memory.app_uid
    chmod 0775 /sys/fs/cgroup/memory.area_anon_refault_threshold
    chmod 0775 /sys/fs/cgroup/memory.avail_buffers
    chmod 0775 /sys/fs/cgroup/memory.compress_ratio
    chmod 0775 /sys/fs/cgroup/memory.cpuload_threshold
    chmod 0775 /sys/fs/cgroup/memory.empty_round_check_threshold
    chmod 0775 /sys/fs/cgroup/memory.empty_round_skip_interval
    chmod 0775 /sys/fs/cgroup/memory.erm_avail_buffer
    chmod 0775 /sys/fs/cgroup/memory.flags
    chmod 0775 /sys/fs/cgroup/memory.max_skip_interval
    chmod 0775 /sys/fs/cgroup/memory.name
    chmod 0775 /sys/fs/cgroup/memory.psi
    chmod 0775 /sys/fs/cgroup/memory.stored_wm_ratio
    chmod 0775 /sys/fs/cgroup/memory.swap_stat
    chmod 0775 /sys/fs/cgroup/memory.swap_stat_array
    chmod 0775 /sys/fs/cgroup/memory.swapd_max_reclaim_size
    chmod 0775 /sys/fs/cgroup/memory.swapd_memcgs_param
    chmod 0775 /sys/fs/cgroup/memory.swapd_nap_jiffies
    chmod 0775 /sys/fs/cgroup/memory.swapd_pid
    chmod 0775 /sys/fs/cgroup/memory.swapd_single_memcg_param
    chmod 0775 /sys/fs/cgroup/memory.total_info_per_app
    chmod 0775 /sys/fs/cgroup/memory.ub_ufs2zram_ratio
    chmod 0775 /sys/fs/cgroup/memory.zram_critical_threshold
    chmod 0775 /sys/fs/cgroup/memory.zram_used_limit_mb
    chmod 0775 /sys/fs/cgroup/memory.zram_wm_ratio
    chmod 0775 /sys/fs/cgroup/memory.force_shrink_anon
    chmod 0775 /sys/fs/cgroup/memory.force_shrink_anon_percent
