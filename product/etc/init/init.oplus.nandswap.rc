    chmod 0775 /sys/fs/cgroup/memory.io_limit_size
    chmod 0775 /sys/fs/cgroup/memory.reclaim
    chmod 0775 /sys/fs/cgroup/memory.stat
    chown system system /sys/fs/cgroup/memory.active_app_info_list
