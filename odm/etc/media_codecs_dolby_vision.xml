<?xml version="1.0" encoding="utf-8" ?>
<Included>
    <Decoders>
        <MediaCodec name="c2.dolby.vision.decoder" type="video/dolby-vision">
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="size" min="16x16" max="8192x4352" />
            <!-- max 8192x4352@60 -->
            <Limit name="block-count" range="1-138240" />
            <Limit name="blocks-per-second" range="1-8294400" />
            <Limit name="bitrate" range="1-240000000" />
            <Feature name="adaptive-playback"/>
            <Feature name="can-swap-width-height"/>
            <Feature name="dynamic-color-aspects"/>
            <!--WangZhikun@MULTIMEDIA.MEDIASERVER.PLAYER 8732247 Add Dolby Codec Feature-->
            <Feature name="oplus-dolby-vision-color-mode" />
            <Limit name="concurrent-instances" max="8" />
            <Limit name="performance-point-3840x2160" value="200" />
            <Limit name="performance-point-1920x1079" value="240" />
        </MediaCodec>
        <MediaCodec name="c2.dolby.vision.decoder.secure" type="video/dolby-vision">
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="size" min="16x16" max="4096x2176" />
            <!-- max 3840x2160@60 -->
            <Limit name="block-count" range="1-34816" />
            <Limit name="blocks-per-second" range="1-2088960" />
            <Limit name="bitrate" range="1-40000000" />
            <Feature name="secure-playback" required="true" />
            <Feature name="adaptive-playback"/>
            <Limit name="concurrent-instances" max="8" />
            <Limit name="performance-point-3840x2160" value="120" />
            <Limit name="performance-point-4096x2176" value="60" />
        </MediaCodec>
    </Decoders>

    <Encoders>
        <MediaCodec name="c2.dolby.encoder.hevc" type="video/dolby-vision">
            <Limit name="size" min="160x128" max="7680x4320" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="80-7776000" />
            <Limit name="block-count" range="80-129600" />
            <Limit name="bitrate" range="1-100000000" />
            <Limit name="frame-rate" range="1-480" />
            <Limit name="complexity" range="0-100"  default="100" />
            <Limit name="concurrent-instances" max="10" />
            <Feature name="bitrate-modes" value="VBR,CBR" />
            <Feature name="intra-refresh" />
            <Feature name="video-minimum-quality" />
            <Feature name="can-swap-width-height"/>
            <Limit name="performance-point-1920x1079" value="180" />
            <Limit name="performance-point-3840x2160" value="120" />
        </MediaCodec>
    </Encoders>
</Included>
