[CzFeaturePipeline]
    # Streaming/Capture[ID] : Node1; Node2; Node3
    #    ID : see CzFeatureScenarioType
    #    NodeX : see CzFeatureNodeType

    ## 1. streaming
    Streaming[1] = SROOT; SAT; LDC; NAV; EIS_REALTIME; VRP; ASYNC; META; SCOMMON;
    Streaming[2] = SROOT; SAT; LDC; VRP; META; SCOMMON;
    Streaming[3] = SROOT; SAT; LDC; NAV; VAINR; TRAW; EIS_REALTIME; EIS_DEFER; VRP; SOD; VWM; ASYNC; META; SCOMMON;
    Streaming[4] = SROOT; SAT; LDC; NAV; MCNR; EIS_REALTIME; WARP; ASYNC; META; SCOMMON;
    Streaming[5] = SROOT; SAT; LDC; NAV; VAINR; TRAW; MCNR; EIS_REALTIME; EIS_DEFER; WARP; SOD; VWM; ASYNC; META; SCOMMON;
    Streaming[6] = SROOT; SAT; LDC; NAV; VAINR; TRAW; EIS_REALTIME; VRP; ASYNC; META; SCOMMON;

    ## 2. capture
    Capture[51] = CROOT; MWCS; RAW; BSS; PACK; CCOMMON;
    Capture[52] = CROOT; RAW; CWDC; BSS; JPEG; CCOMMON;
    Capture[53] = CROOT; REPROCESS;
    Capture[54] = CROOT; MFNR; RAW; CWDC; JPEG; CCOMMON;

    # default inline
    NonInlineModeList = 0x80a3;

[FeatureCalidataMeta]
    #key                          LogicalSensorName(main, ultra wide, tricam and bayerwide)
    DistortionSensorList[0]   =   MAIN;
    DistortionSensorList[1]   =   UWIDE;
    DistortionSensorList[2]   =   TELE;
    DistortionSensorList[3]   =   triscam;
    DistortionSensorList[4]   =   bayerwide;

[FeatureManualAeTypeMap]
    #key             operation_mode     sensorId   expTime(us)     afeGain     ispGain
    Mode[0] =           0x9008;            2;         4200;         1024;        4096      #StreamConfigCapModeTriCalib105CM
    Mode[1] =           0x9009;            2;         4200;         1024;        4096      #StreamConfigCapModeTriVerif105CM

[EepromHelperConfig]
    #key
    enableOIS[0]  =    false
    enableOIS[1]  =    false
    enableOIS[2]  =    false
    enableOIS[3]  =    false
    enableOIS[4]  =    false
    enableOIS[5]  =    false

[FeatureIzoom]
    SupportTeleIzoom = true
    UseIZoomQbcModeList = 0x8030;
    #phyId        #isSupportIZoom     #IZoomRatioPoint    #4XIZoomRatioPoint
    Izoom[1] =            0;                   0;
    Izoom[2] =            1;                   2.0;
    Izoom[3] =            0;                   0;
    Izoom[4] =            1;                   6.0;                12.0;
    # enable advancedDecideIzoomEx: AdvancedIzoomEx[i] = OpMode; CamId0; ...; CamIdN; (N=1~6)
    #key                    OpMode     CamId0   CamId1  CamId2  CamId3  CamId4  CamId5
    AdvancedIzoomEx[0] =    0x8001;    4        # Common + tele

[FeatureOIS]
    #key               OpMode     CameraId     Type
    Mode[0]    =        0x8028;       2;         0    #sois
    Mode[1]    =        0x80A4;       2;         0    #sois
    Mode[2]    =        0x80A4;       4;         0    #sois
