[OPlusEISSettings]
    EisThresholdOfTemperature = 55;

    DisableTeleFeatureRatio = 6.0;

    ImageAidEnable = true;

    NeedDynamicOisMode = FALSE;

    NeedDynamicSoisMode = FALSE;

    EnableRectBaseOutFrame = FALSE;

    EnableShortExpMask = 0xFF;

    IsNeedLagCoeffsShdr = FALSE;

    ImuLagCoeffsShdr = 0; 0; 0; -16000; 0;

    OisImuLagCoeffsShdr = 0; 0; 0; -16000; 0;

    EisReadoutTimeDol = 31416;

    IsEnableEisSingleton = true;

    #EisDecisonPoint         enter   process   image     maxCropFactor
    photo_mode =             3.0;      6.5;     10.0;     7.0;
    night_mode =             3.0;      6.5;     10.0;     7.0;
    macro_closeup_mode =     1.0;      2.17;    2.17;     0.0;
    telephoto_capture_mode = 1.0;      2.17;    2.17;     0.0;
    high_pixel_mode =        1.0;      0.0;     0.0;      0.0;

    #key                      CameraId       EisReadoutTimeDcg(unit: us)
    EisReadoutTimeDcg[0] =        0;                 12800;
    EisReadoutTimeDcg[1] =        2;                 26614;
    EisReadoutTimeDcg[2] =        3;                 27157;

    #key                       CameraId       EisReadoutTimeLbmf(unit: us)
    EisReadoutTimeLbmf[0] =      0;                 13537;
    EisReadoutTimeLbmf[1] =      2;                 15969;
    EisReadoutTimeLbmf[2] =      3;                 16138;

    EisFlushCountDefault = 5;

    EisFlushCountHighSpeed = 2;

    IsNeedUseF1Stream = TRUE;

    #HorizonStabilization
    EnableAccData = TRUE;
    EnableGravityData = TRUE;
    EnableHorizonStabilization = TRUE;
    HorizonStabAspectRatio = 16:10;

    NeedHalCallInitRender = TRUE;

[TeleConvectorEis]
    #TeleConvectorEisFactor    factor0    factor1    factor2    factor3    factor4
    TeleConvectorEisFactor = 1.0; 1.2; 1.2; 1.5; 2.5;

    #TeleConvectorEisPoint    point0    point1    point2    point3    point4
    TeleConvectorEisPoint = 2.2; 2.5; 4.4; 6.0; 20.0;

    #TeleConvectorParam    convectorFactor      mapRatio
    TeleConvectorParam = 3.303; 10;

[FeatureVideoMcs]
    otpSize        = 20;
    dataVersion    = 105;

    #Mcs algo config
    maxLineCount   = 8400;
    tLine          = 22.8;
    rangeLow       = 200.0;
    rangeHigh      = 300.0;
    DCGSwitch      = 1;
    fixExpRatio    = 16.0;
    mcsApiType     = 1;  #  0:3rd   1:oplus

    #video Mcs config
    mcsVideoEnable = 1;
    width          = 1024;
    height         = 768;
    channel        = 1;
    mirror         = 0;
    region_mode    = 2;
    OplusIsEnableCsExif = true;
    mcsVideoMode   = 0x800B; 0x8021; 0x8028; 0x80A7;
    recordWidthLimit = 4000;

    #power Mcs config
    MCSHighTempThreshold = 45;
    MCSHighTempResumeThreshold = 43;

[MacroEISConfig]
    MacroEisCameraId = 0;
    MacroEisSensorId = 2;
    MacroEisOperationMode = 0x8001; 0x8019;
    MacroEisEnable = TRUE;
    MacroEisRatioCoefficient = 1.0;

[FeatureLdcConfigList]
    full_dimension_size = 4096; 3072
    # key       CapMode    featureMask
    Mode[0] =   0x8007;         -1;
    Mode[1] =   0x8001;          2;
    Mode[2] =   0x80A7;          7;
    Mode[3] =   0x8021;          7;
    Mode[4] =   0x80CD;         -1;
    Mode[5] =   0x80AF;         -1;

[FeatureAwbGainProtectForThirdCam]
    #key                                                                              value
    com.tencent.mm.ui.LauncherUI                                                  =     true;
    com.tencent.mm.plugin.voip.ui.VideoActivity                                   =     true;
    com.tencent.mm.plugin.profile.ui.ContactInfoUI                                =     true;
    com.tencent.mm.ui.chatting.ChattingUI                                         =     true;

