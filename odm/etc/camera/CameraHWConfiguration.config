    ForceBinningTo24FPS = 2; 4;
    SetAishutterValue = 0;
    ExtensionEnableLux = 470;
    teleConvEisFactor = 1.0; 1.2; 1.2; 1.5;  2.5;
    teleConvEisPoint =  2.2; 2.5; 4.4; 6.0; 20.0;
    teleConVainrSensorId = 4;
    MinDebExifSize = 129600;    # 480*270
