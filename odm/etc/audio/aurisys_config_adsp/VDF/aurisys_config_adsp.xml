        </aurisys_scenario>
        <aurisys_scenario aurisys_scenario="AURISYS_SCENARIO_DSP_PLAYBACK_SMARTPA_RINGTONE">
            <downlink_library_name_list digital_gain_lib_name="">
                <library name="smartpa_tfaxxxx"/>
