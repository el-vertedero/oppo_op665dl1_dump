		disp-dvo1 = "/soc/disp-dvo1@3ea90000";
		bwm0 = "/soc/disp-bwm0@3ebd0000";
		disp-wla0 = "/soc/disp-wla0@3ecb0000";
		mutex0 = "/soc/disp1-mutex0@3e320000";
		mdp-rdma1 = "/soc/disp1-mdp-rdma1@3e7b0000";
		mdp-rdma6 = "/soc/disp-mdp-rdma6@3e6c0000";
		mml-mutex0 = "/soc/mml1-mutex0@32320000";
		mml-mutex1 = "/soc/mml2-mutex0@32620000";
		mml-wrot0 = "/soc/mml2-wrot0@327e0000";
		mml-wrot1 = "/soc/mml2-wrot1@327f0000";
		wdma0 = "/soc/disp1-wdma0@3e740000";
		wdma1 = "/soc/disp1-wdma1@3e750000";
		mtksmmu0 = "/soc/iommu@14900000";
		mtksmmu1 = "/soc/iommu@30800000";
		mtksmmu2 = "/soc/iommu@4c000000";
		mtksmmu3 = "/soc/iommu@74c00000";
	};

	aov {
		compatible = "mediatek,aov";
		status = "okay";
		op-mode = <0x01>;
		mediatek,larbs-uisp = <0x02>;
		scp-dvfs-supply = <0x03>;
		vcp-supply = <0x04>;
		seninf-top-supply = <0x05>;
		ulposc-support;
		base = <0x1ad04200>;
		ver = "isp66";
		phandle = <0x3b4>;
	};

	cache-parity {
		compatible = "mediatek,mt6985-cache-parity";
		ecc-irq-support = <0x01>;
		arm-dsu-ecc-hwirq = <0x2a>;
		interrupts = <0x00 0x00 0x04 0x00 0x00 0x01 0x04 0x00 0x00 0x02 0x04 0x00 0x00 0x03 0x04 0x00 0x00 0x04 0x04 0x00 0x00 0x05 0x04 0x00 0x00 0x06 0x04 0x00 0x00 0x07 0x04 0x00 0x00 0x0a 0x04 0x00>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    8250.nr_uarts=6 \t\t\t    nosoftlockup \t\t\t    androidboot.hardware=mt6995 \t\t\t    sched_proxy_exec=0 \t\t\t    android_arch_task_struct_size=512 \t\t\t    vmalloc=400M swiotlb=noforce \t\t\t    firmware_class.path=/vendor/firmware,/odm/firmware/oplus_direct_load_kernel \t\t\t    kvm-arm.hyp_lm_size_mb=2000 \t\t\t    kvm-arm.protected_prefault=5 \t\t\t    kvm-arm.protected_modules=pkvm_mgmt,pkvm_tmem,pkvm_smmu,pkvm_cmdq_mt6995,pkvm_mkp,pkvm_isp_6995,pkvm_seninf_6995 \t\t\t    maxcpus=8 \t\t\t    cgroup.memory=nosocket,nokmem \t\t\t    disable_dma32=on \t\t\t    transparent_hugepage=never \t\t\t    log_buf_len=2m \t\t\t    kvm-arm.host_s2=carveout \t\t\t    arm64.nomops";
		mkp_panic = "on";
		phandle = <0x5a>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			reg = <0x00>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x323>;
			phandle = <0x12>;
		};

		cpu@1 {
			device_type = "cpu";
			reg = <0x100>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x323>;
			phandle = <0x13>;
		};

		cpu@2 {
			device_type = "cpu";
			reg = <0x200>;
			performance-domains = <0x06 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x07 0x08 0x09 0x0a 0x0b>;
			capacity-dmips-mhz = <0x323>;
			phandle = <0x14>;
		};

		cpu@100 {
			device_type = "cpu";
			reg = <0x300>;
			performance-domains = <0x06 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d 0x0e 0x0a 0x0b>;
			capacity-dmips-mhz = <0x395>;
			phandle = <0x15>;
		};

		cpu@101 {
			device_type = "cpu";
			reg = <0x400>;
			performance-domains = <0x06 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d 0x0e 0x0a 0x0b>;
			capacity-dmips-mhz = <0x395>;
			phandle = <0x16>;
		};

		cpu@102 {
			device_type = "cpu";
			reg = <0x500>;
			performance-domains = <0x06 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0c 0x0d 0x0e 0x0a 0x0b>;
			capacity-dmips-mhz = <0x395>;
			phandle = <0x17>;
		};

		cpu@200 {
			device_type = "cpu";
			reg = <0x600>;
			performance-domains = <0x06 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10 0x11 0x0a 0x0b>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x18>;
		};

		cpu@201 {
			device_type = "cpu";
			reg = <0x700>;
			performance-domains = <0x06 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0f 0x10 0x11 0x0a 0x0b>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x19>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x16>;
				};

				core2 {
					cpu = <0x17>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x18>;
				};

				core1 {
					cpu = <0x19>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x47>;
				exit-latency-us = <0x8c>;
				min-residency-us = <0x37b5>;
				phandle = <0x07>;
			};

			cpuoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x53>;
				exit-latency-us = <0x8b>;
				min-residency-us = <0x2dc9>;
				phandle = <0x0c>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x67>;
				exit-latency-us = <0xa5>;
				min-residency-us = <0x13ba>;
				phandle = <0x0f>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x12c>;
				exit-latency-us = <0x1e0>;
				min-residency-us = <0x37b5>;
				phandle = <0x08>;
			};

			clusteroff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x13a>;
				exit-latency-us = <0x1e9>;
				min-residency-us = <0x2dc9>;
				phandle = <0x0d>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x14d>;
				exit-latency-us = <0x23e>;
				min-residency-us = <0x13ba>;
				phandle = <0x10>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x2010007>;
				local-timer-stop;
				entry-latency-us = <0x41d>;
				exit-latency-us = <0x80f>;
				min-residency-us = <0x37b5>;
				phandle = <0x09>;
			};

