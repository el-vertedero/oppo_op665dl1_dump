		gamma4 = "/soc/disp0b-disp-gamma0@3e5c0000";
		dither0 = "/soc/disp-dither0@3e3a0000";
		dither1 = "/soc/disp-dither1@3e3b0000";
		dither4 = "/soc/disp0b-disp-dither0@3e5a0000";
		chist0 = "/soc/disp-chist0@3e810000";
		chist1 = "/soc/disp-chist1@3e820000";
		spr0 = "/soc/disp-spr0@3e470000";
		postalign0 = "/soc/disp-postalign0@3e770000";
