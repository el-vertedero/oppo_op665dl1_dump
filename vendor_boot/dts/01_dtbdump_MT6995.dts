/dts-v1/;

/ {
	model = "MT6995";
	compatible = "mediatek,MT6995";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	pkvm {
		compatible = "mediatek,pkvm";
		status = "okay";
		mtkcam-security-cam-normal-preview-support = "disable";
		phandle = <0x3b2>;

		tmem {
			whitelist-range = <0x00 0x00 0x1ad40000 0x00 0x20000>;
			phandle = <0x3b3>;
		};
	};

	aliases {
		i2c0 = "/soc/i2c@13a50000";
