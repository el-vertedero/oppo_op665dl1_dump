		dbi-count0 = "/soc/disp-dbi-count0@3e760000";
		mdp-rsz0 = "/soc/disp-mdp-rsz0@3e3f0000";
		mdp-rsz7 = "/soc/disp0b-disp-mdp-rsz0@3e5f0000";
		postmask0 = "/soc/disp-postmask0@3e3e0000";
