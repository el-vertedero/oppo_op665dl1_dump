		mdp-rsz4 = "/soc/ovl1-ovl-mdp-rsz0@32db0000";
		dsc0 = "/soc/disp1-dsc-wrap0@3e7a0000";
		dsc8 = "/soc/disp1b-dsc-wrap0@3e9a0000";
		dli-async-b0 = "/soc/dli-async0-b@3e500000";
		dlo-async-b0 = "/soc/dlo-async0-b@3e500000";
		dli-async-b20 = "/soc/dli-async20-b@3e900000";
