    <oplus-feature name="oplus.software.display.colormode_standard_support"/>
    <!-- Add for dual light sensor support-->
    <oplus-feature name="oplus.software.display.dual_lightsensor_support"/>
    <!-- Add for game dark eyeprotect -->
    <oplus-feature name="oplus.software.display.game_dark_eyeprotect_support"/>
    <!-- Add for game color enhancement2.0 -->
    <oplus-feature name="oplus.software.display.game_color_enhance_2.0"/>
    <!-- Add for game color filter2.0 -->
    <oplus-feature name="oplus.software.display.game_filter_2.0"/>
    <!-- feature dsr -->
    <oplus-feature name="oplus.software.display.dsr_support"/>
    <!-- Add for reduce white point -->
    <oplus-feature name="oplus.software.display.reduce_white_point"/>
    <!--add for dynamic brightness range-->
    <oplus-feature name="oplus.software.display.dynamic_screen_bar_support"/>
    <!-- Add for display calbrication 100APL calibrate  -->
    <oplus-feature name="oplus.software.display.screen_calibrate_100apl"/>
    <oplus-feature name="oplus.software.display.colormode_calibrate_support" />
    <!-- Add for display BT2020 panel support  -->
    <oplus-feature name="oplus.software.display.bt2020_panel_support" />
    <!-- Add for display BT2020 allbrightness colorappearance  -->
    <oplus-feature name="oplus.hardware.display.allbrightness_colorappearance" />

    <oplus-feature name="oplus.software.app_resolution_switch" />
    <oplus-feature name="oplus.software.display.resolution_switch_support"/>
    <oplus-feature name="oplus.software.display.hdr_vision_support"/>
    <oplus-feature name="oplus.software.display.dolby_vision_support"/>
    <!-- LuLiang@MULTIMEDIA.DISPLAY, 2026/04/20,add for Framerate feature -->
    <oplus-feature name="oplus.software.display.dynamic_fps_switch" />
    <oplus-feature name="oplus.software.display.multi_device_decrease_refresh_rate"/>
    <oplus-feature name="oplus.software.display.adfr"/>
    <oplus-feature name="oplus.software.display.refreshrate_default_smart"/>
    <!-- ultra low power aod feature -->
    <oplus-feature name="oplus.software.display.oha_support" />
    <!-- intelligent_color_temperature_lut_support.4.0 -->
    <oplus-feature name="oplus.software.display.intelligent_color_temperature_lut_support" />
