service frs /vendor/bin/frs
    class main
    socket frs_socket stream 660 root system
    user root
    group system
    disabled

on property:sys.boot_completed=1
    start frs

on property:sys.boot_completed=1 && property:ro.boot.prjname=26845
    stop frs

on property:sys.boot_completed=1 && property:ro.boot.prjname=26881
    stop frs

on property:sys.boot_completed=1 && property:ro.boot.prjname=26885
    stop frs


