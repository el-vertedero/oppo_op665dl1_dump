on early-init
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2100000
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_max_freq 2900000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2900000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2750000
    write /sys/class/devfreq/mtk-dvfsrc-devfreq/userspace/set_freq 0

on early-init && property:ro.boot.perf_state=1
    # boot perf. tune
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 1200000
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_min_freq 1200000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 1200000
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 1200000

on charger
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 0


on post-fs-data
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor sugov_ext
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_governor sugov_ext
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_governor sugov_ext
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor sugov_ext
    write /proc/sys/kernel/sched_pelt_multiplier 4
    write /proc/sys/kernel/sched_util_clamp_min_rt_default 0

    write /sys/devices/system/cpu/cpu0/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu1/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu2/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu3/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu4/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu5/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu6/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu7/cpufreq/sugov_ext/up_rate_limit_us 0
    write /sys/devices/system/cpu/cpu0/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu1/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu2/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu3/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu4/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu5/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu6/cpufreq/sugov_ext/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpu7/cpufreq/sugov_ext/down_rate_limit_us 0

on post-fs-data && property:ro.boot.perf_state=1
    # boot perf. tune
    write /dev/cpuctl/system/cpu.uclamp.min 100
    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/system-background/cpu.uclamp.min 100
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/foreground/cpu.uclamp.min 100
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/top-app/cpu.uclamp.min 100
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 1
    write /dev/cpuctl/background/cpu.uclamp.min 100
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 1

on boot
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy3/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy3/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chown system system /sys/devices/system/cpu/cpufreq/policy6/scaling_governor
    chmod 0660 /sys/devices/system/cpu/cpufreq/policy6/scaling_governor

on property:sys.boot_completed=1
    write /proc/sys/kernel/sched_migration_cost_ns 200000

    # start cpuqos
    write /sys/devices/system/cpu/cpuqos/cpuqos_boot_complete 1

    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2147483647
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_max_freq 2147483647
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2147483647
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2147483647

on property:sys.boot_completed=1 && property:ro.boot.perf_state=1

    # restore boot perf. tune
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy3/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 0
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 0

    write /dev/cpuctl/system/cpu.uclamp.min 0
    write /dev/cpuctl/system/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/system-background/cpu.uclamp.min 0
    write /dev/cpuctl/system-background/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/foreground/cpu.uclamp.min 0
    write /dev/cpuctl/foreground/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/top-app/cpu.uclamp.latency_sensitive 0
    write /dev/cpuctl/background/cpu.uclamp.min 0
    write /dev/cpuctl/background/cpu.uclamp.latency_sensitive 0

    #config fg and top cpu shares
    write /dev/cpuctl/top-app/cpu.shares 5120
    write /dev/cpuctl/sstop/cpu.shares 5120
    write /dev/cpuctl/foreground/cpu.shares 4096
    write /dev/cpuctl/ssfg/cpu.shares 4096


