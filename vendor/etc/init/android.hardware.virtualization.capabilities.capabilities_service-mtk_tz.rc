service vendor.vm_capabilities_service-mtk_tz /vendor/bin/hw/android.hardware.virtualization.capabilities.capabilities_service-mtk_tz
  interface aidl android.hardware.virtualization.capabilities.IVmCapabilitiesService/default
  oneshot
  disabled
  # This HAL needs to talk to a kernel driver, hence it runs as root
  user root
  group root

