# TODO(b/393848753): determine whether task_profiles shall be defined
service dbi_vendor_vm_launcher /vendor/bin/memshare_trusty_vm_launcher_vendor \
--name vendor_dbi_vm \
--kernel /vendor/etc/vm/trusty_vm/dbi_vm.elf \
--rpc-services-config /vendor/etc/vm/trusty_vm/dbi_vm_rpc_services.json \
--vm-instance-id /vendor/etc/vm/trusty_vm/dbi_vm_instance_id \
--memory-size-mib 32 \
--cpus 1,2,3 \
--tee-services vendor.mtk_tz_service \
--protected
    user root
    group system virtualmachine
    capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE
    stdio_to_kmsg
    oneshot
    interface aidl android.os.IAccessor/ICommandProcessor/memshare_vm
    interface aidl android.os.IAccessor/IMemoryBufferShareVm/memshare_vm

on property:ro.boot.hypervisor.version=kvm && property:persist.vendor.sys.pq.oddmr_dbi_support=1
    start dbi_vendor_vm_launcher
