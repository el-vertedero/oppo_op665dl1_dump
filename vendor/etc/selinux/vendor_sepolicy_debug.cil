(allow init_202604 hal_atrace_default_exec (file (read getattr map execute open)))
;;* lme
;;* lmx 5 system/sepolicy/vendor/hal_atrace_default.te
(allow init_202604 hal_atrace_default (process (transition)))
;;* lme
;;* lmx 5 system/sepolicy/vendor/hal_atrace_default.te
(allow hal_atrace_default hal_atrace_default_exec (file (read getattr map execute open entrypoint)))
;;* lme
(dontaudit init_202604 hal_atrace_default (process (noatsecure)))
;;* lmx 5 system/sepolicy/vendor/hal_atrace_default.te
(allow init_202604 hal_atrace_default (process (siginh rlimitinh)))
;;* lme
(typetransition init_202604 hal_atrace_default_exec process hal_atrace_default)
;;* lmx 8 system/sepolicy/vendor/hal_atrace_default.te
(allow hal_atrace_default debugfs_tracing_202604 (dir (ioctl read getattr lock open watch watch_reads search)))
;;* lme
;;* lmx 9 system/sepolicy/vendor/hal_atrace_default.te
(allow hal_atrace_default debugfs_tracing_202604 (file (ioctl read write getattr lock append map open watch watch_reads)))
;;* lme
;;* lmx 5 system/sepolicy/vendor/hal_audio_default.te
(allow init_202604 hal_audio_default_exec (file (read getattr map execute open)))
;;* lme
;;* lmx 5 system/sepolicy/vendor/hal_audio_default.te
