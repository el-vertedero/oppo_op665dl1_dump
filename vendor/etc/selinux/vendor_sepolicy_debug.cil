;;* lmx 5 system/sepolicy/vendor/hal_audio_default.te
(allow init_202604 hal_audio_default (process (siginh rlimitinh)))
;;* lme
(typetransition init_202604 hal_audio_default_exec process hal_audio_default)
;;* lmx 7 system/sepolicy/vendor/hal_audio_default.te
